<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_property_offers_table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th><strong>Price</strong></th>
                    <th><strong>Partner</strong></th>
                    <th><strong>Validity (days)</strong></th>
                    <th><strong>Deadline</strong></th>
                    <th><strong>State</strong></th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="offers" t-as="offer">
                    <td><span t-field="offer.price"/></td>
                    <td><span t-field="offer.partner_id"/></td>
                    <td><span t-field="offer.validity"/></td>
                    <td><span t-field="offer.date_deadline"/></td>
                    <td><span t-field="offer.status"/></td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_property_offer_template">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="property.name"/>
                        </h2>
                        <div>
                            <strong>Salesman: </strong>
                            <span t-field="property.salesperson_id"/>
                        </div>
                        <div>
                            <strong>Expected Price: </strong>
                            <span t-field="property.expected_price"/>
                        </div>
                        <div>
                            <strong>Status: </strong>
                            <span t-field="property.state"/>
                        </div>
                        <t t-call="estate.report_property_offers_table">
                            <t t-set="offers" t-value="property.offer_ids"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_estate_property" model="ir.actions.report">
        <field name="name">Property Offers</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">estate.report_property_offer_template</field>
        <field name="report_file">estate.report_property_offer_template</field>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_user_properties_template">
        <t t-foreach="docs" t-as="user">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1>Properties for <span t-field="user.name"/></h1>

                        <t t-if="user.property_ids">
                            <t t-foreach="user.property_ids" t-as="property">
                                <div style="margin-top: 20px;">
                                    <h3><span t-field="property.name"/></h3>
                                    <div>
                                        <strong>Expected Price: </strong>
                                        <span t-field="property.expected_price"/>
                                    </div>
                                    <div>
                                        <strong>Status: </strong>
                                        <span t-field="property.state"/>
                                    </div>
                                    <t t-if="property.offer_ids">
                                        <h4>Offers:</h4>
                                        <t t-call="estate.report_property_offers_table">
                                            <t t-set="offers" t-value="property.offer_ids"/>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <p><em>No offers for this property.</em></p>
                                    </t>
                                </div>
                                <hr/>
                            </t>
                        </t>
                        <t t-else="">
                            <p><em>No properties assigned to this user.</em></p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_user_properties" model="ir.actions.report">
        <field name="name">User Properties</field>
        <field name="model">res.users</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">estate.report_user_properties_template</field>
        <field name="report_file">estate.report_user_properties_template</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_type">report</field>
    </record>
</odoo>