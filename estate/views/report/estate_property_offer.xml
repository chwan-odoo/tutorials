<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="property_offer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Property Offers Report</h2>

                        <!-- Property Information -->
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Property Name:</strong> <span t-field="o.name"/><br/>
                                <strong>Postcode:</strong> <span t-field="o.postcode"/><br/>
                                <strong>Expected Price:</strong> <span t-esc="'${:,.2f}'.format(o.expected_price)"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Bedrooms:</strong> <span t-field="o.bedrooms"/><br/>
                                <strong>Living Area:</strong> <span t-field="o.living_area"/> m²<br/>
                                <strong>State:</strong> <span t-field="o.state"/><br/>
                            </div>
                        </div>

                        <t t-if="o.offer_ids">
                            <!-- Offers Table -->
                            <h4>Property Offers</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Partner</th>
                                        <th>Price</th>
                                        <th>Validity (days)</th>
                                        <th>Deadline</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.offer_ids" t-as="offer">
                                        <td><span t-field="offer.partner_id.name"/></td>
                                        <td><span t-esc="'${:,.2f}'.format(offer.price)"/></td>
                                        <td><span t-field="offer.validity"/></td>
                                        <td><span t-field="offer.date_deadline"/></td>
                                        <td>
                                            <span t-if="offer.status == 'accepted'" class="badge badge-success">Accepted</span>
                                            <span t-elif="offer.status == 'refused'" class="badge badge-danger">Refused</span>
                                            <span t-else="" class="badge badge-secondary">Pending</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Best Offer Summary -->
                            <div class="row mt-3">
                                <div class="col-12">
                                    <p><strong>Best Offer:</strong> <span t-esc="'${:,.2f}'.format(o.best_offer)"/></p>
                                    <p t-if="o.selling_price"><strong>Selling Price:</strong> <span t-esc="'${:,.2f}'.format(o.selling_price)"/></p>
                                </div>
                            </div>
                        </t>

                        <t t-else="">
                            <!-- No Offers Message -->
                            <div class="alert alert-info mt-4" role="alert">
                                <h5 class="alert-heading">No Offers Yet</h5>
                                <p>This property has not received any offers at this time. Please check back later or contact the salesperson for more information.</p>
                            </div>
                        </t>

                        <!-- Additional Property Details -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5>Property Description</h5>
                                <p t-field="o.description"/>
                            </div>
                        </div>

                        <t t-if="o.salesperson_id">
                            <div class="row mt-3">
                                <div class="col-12">
                                    <strong>Salesperson:</strong> <span t-field="o.salesperson_id.name"/><br/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_property_offer" model="ir.actions.report">
        <field name="name">Property Offers</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">estate.property_offer</field>
        <field name="report_file">estate.property_offer</field>
        <field name="binding_model_id" ref="estate.model_estate_property"/>
        <field name="binding_type">report</field>
    </record>
    </data>
</odoo>