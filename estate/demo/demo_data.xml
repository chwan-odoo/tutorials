<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Demo Partners for Estate Offers -->
        <record id="estate_partner_1" model="res.partner">
            <field name="name">Azure Interior</field>
            <field name="email">azure.interior@example.com</field>
            <field name="phone">+1-555-0101</field>
        </record>

        <record id="estate_partner_2" model="res.partner">
            <field name="name">Deco Addict</field>
            <field name="email">deco.addict@example.com</field>
            <field name="phone">+1-555-0102</field>
        </record>

        <record id="estate_partner_3" model="res.partner">
            <field name="name">Gemini Furniture</field>
            <field name="email">gemini.furniture@example.com</field>
            <field name="phone">+1-555-0103</field>
        </record>

        <record id="estate_partner_4" model="res.partner">
            <field name="name">Ready Mat</field>
            <field name="email">ready.mat@example.com</field>
            <field name="phone">+1-555-0104</field>
        </record>

        <!-- Demo Estate Properties -->
        <record id="estate_property_big_villa" model="estate.property">
            <field name="name">Big Villa</field>
            <field name="state">new</field>
            <field name="description">A nice and big villa</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2020-02-02</field>
            <field name="expected_price">1600000</field>
            <field name="selling_price">120000</field>
            <field name="bedrooms">6</field>
            <field name="living_area">100</field>
            <field name="facades">4</field>
            <field name="garage" eval="True"/>
            <field name="garden" eval="True"/>
            <field name="garden_area">100000</field>
            <field name="garden_orientation">south</field>
        </record>

        <record id="estate_property_trailer_home" model="estate.property">
            <field name="name">Trailer home</field>
            <field name="state">cancelled</field>
            <field name="description">Home in a trailer park</field>
            <field name="postcode">54321</field>
            <field name="date_availability">1970-01-01</field>
            <field name="expected_price">100000</field>
            <field name="bedrooms">1</field>
            <field name="living_area">10</field>
            <field name="facades">4</field>
            <field name="garage" eval="False"/>
            <field name="garden" eval="False"/>
        </record>

        <!-- Offers for SOLD Property (Luxury Penthouse from data file) -->
        <record id="offer_penthouse_1" model="estate.property.offer">
            <field name="price">2400000</field>
            <field name="validity">10</field>
            <field name="status">refused</field>
            <field name="partner_id" ref="estate_partner_1"/>
            <field name="property_id" ref="estate.estate_property_luxury_penthouse"/>
        </record>

        <record id="offer_penthouse_2" model="estate.property.offer">
            <field name="price">2600000</field>
            <field name="validity">14</field>
            <field name="status">refused</field>
            <field name="partner_id" ref="estate_partner_3"/>
            <field name="property_id" ref="estate.estate_property_luxury_penthouse"/>
        </record>

        <record id="offer_penthouse_3" model="estate.property.offer">
            <field name="price">2700000</field>
            <field name="validity">7</field>
            <field name="status">accepted</field>
            <field name="partner_id" ref="estate_partner_2"/>
            <field name="property_id" ref="estate.estate_property_luxury_penthouse"/>
        </record>

        <!-- Offers for OFFER RECEIVED Property (Suburban House from data file) -->
        <record id="offer_suburban_1" model="estate.property.offer">
            <field name="price">620000</field>
            <field name="validity">7</field>
            <field name="partner_id" ref="estate_partner_4"/>
            <field name="property_id" ref="estate.estate_property_suburban_house"/>
        </record>

        <record id="offer_suburban_2" model="estate.property.offer">
            <field name="price">640000</field>
            <field name="validity">10</field>
            <field name="partner_id" ref="estate_partner_1"/>
            <field name="property_id" ref="estate.estate_property_suburban_house"/>
        </record>

        <record id="offer_suburban_3" model="estate.property.offer">
            <field name="price">660000</field>
            <field name="validity">14</field>
            <field name="partner_id" ref="estate_partner_3"/>
            <field name="property_id" ref="estate.estate_property_suburban_house"/>
        </record>
    </data>
</odoo>
