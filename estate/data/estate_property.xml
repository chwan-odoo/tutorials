<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Demo Estate Properties -->
        <!-- Property 1: SOLD -->
        <record id="estate_property_luxury_penthouse" model="estate.property">
            <field name="name">Luxury Penthouse Downtown</field>
            <field name="state">sold</field>
            <field name="description">Stunning penthouse with panoramic city views, high-end finishes, and rooftop terrace</field>
            <field name="postcode">90210</field>
            <field name="date_availability">2025-01-15</field>
            <field name="expected_price">2500000</field>
            <field name="selling_price">2700000</field>
            <field name="bedrooms">4</field>
            <field name="living_area">350</field>
            <field name="facades">2</field>
            <field name="garage" eval="True"/>
            <field name="garden" eval="True"/>
            <field name="garden_area">150</field>
            <field name="garden_orientation">south</field>
            <field name="buyer_id" ref="estate.estate_partner_2"/>
        </record>

        <!-- Property 2: OFFER RECEIVED -->
        <record id="estate_property_suburban_house" model="estate.property">
            <field name="name">Charming Suburban Family Home</field>
            <field name="state">offer_received</field>
            <field name="description">Beautiful 3-bedroom home in quiet neighborhood with large backyard</field>
            <field name="postcode">10001</field>
            <field name="date_availability">2025-03-01</field>
            <field name="expected_price">650000</field>
            <field name="bedrooms">3</field>
            <field name="living_area">200</field>
            <field name="facades">4</field>
            <field name="garage" eval="True"/>
            <field name="garden" eval="True"/>
            <field name="garden_area">500</field>
            <field name="garden_orientation">east</field>
        </record>

        <!-- Property 3: NEW -->
        <record id="estate_property_modern_condo" model="estate.property">
            <field name="name">Modern Downtown Condo</field>
            <field name="state">new</field>
            <field name="description">Brand new condo in the heart of the city with all amenities</field>
            <field name="postcode">20001</field>
            <field name="date_availability">2025-06-01</field>
            <field name="expected_price">450000</field>
            <field name="bedrooms">2</field>
            <field name="living_area">120</field>
            <field name="facades">1</field>
            <field name="garage" eval="True"/>
            <field name="garden" eval="False"/>
        </record>

        <!-- Original Demo Properties -->
        <record id="estate_property_big_villa" model="estate.property">
            <field name="name">Big Villa</field>
            <field name="state">new</field>
            <field name="description">A nice and big villa</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2020-02-02</field>
            <field name="expected_price">1600000</field>
            <field name="bedrooms">6</field>
            <field name="living_area">100</field>
            <field name="facades">4</field>
            <field name="garage" eval="True"/>
            <field name="garden" eval="True"/>
            <field name="garden_area">100000</field>
            <field name="garden_orientation">south</field>
        </record>

        <record id="estate_property_trailer_home" model="estate.property">
            <field name="name">Trailer home</field>
            <field name="state">cancelled</field>
            <field name="description">Home in a trailer park</field>
            <field name="postcode">54321</field>
            <field name="date_availability">1970-01-01</field>
            <field name="expected_price">100000</field>
            <field name="selling_price">120000</field>
            <field name="bedrooms">1</field>
            <field name="living_area">10</field>
            <field name="facades">4</field>
            <field name="garage" eval="False"/>
            <field name="garden" eval="False"/>
        </record>
    </data>
</odoo>
