<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sale_team_leader" model="res.groups">
        <field name="name">User: Team Leader</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">The user will have access to their own documents and documents of team members in teams they lead.</field>
    </record>

    <record id="sales_team.group_sale_salesman_all_leads" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sale_team_leader'))]"/>
    </record>

    <data noupdate="1">
        <record id="sale_order_team_leader_rule" model="ir.rule">
            <field name="name">Team Leader Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[
                '|', '|',
                    ('user_id', '=', user.id),
                    ('user_id', '=', False),
                    ('user_id.sale_team_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_sale_team_leader'))]"/>
        </record>

        <record id="sale_order_line_team_leader_rule" model="ir.rule">
            <field name="name">Team Leader Order Lines</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[
                '|', '|',
                    ('salesman_id', '=', user.id),
                    ('salesman_id', '=', False),
                    ('salesman_id.sale_team_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_sale_team_leader'))]"/>
        </record>

        <record id="sale_order_report_team_leader_rule" model="ir.rule">
            <field name="name">Team Leader Orders Analysis</field>
            <field name="model_id" ref="sale.model_sale_report"/>
            <field name="domain_force">[
                '|', '|',
                    ('user_id', '=', user.id),
                    ('user_id', '=', False),
                    ('user_id.sale_team_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_sale_team_leader'))]"/>
        </record>
    </data>
</odoo>

