<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <div class="o_dashboard h-100">
            <div class="o_control_panel d-flex align-items-center p-3 border-bottom">
                <button class="btn btn-primary me-2" t-on-click="openCustomers">
                    Customers
                </button>
                <button class="btn btn-primary me-2" t-on-click="openLeads">
                    Leads
                </button>
                <h2 class="mb-0">Dashboard</h2>
            </div>
            <div class="d-flex flex-wrap">
                <DashboardItem>
                    <div class="d-flex">
                        <span class="flex-column me-3">Number of new orders this month</span>
                        <span class="flex-column o_stat_highlight"><t t-esc="state.stats.nb_new_orders"/></span>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="d-flex">
                        <span class="flex-column me-3">Total amount of new orders this month</span>
                        <span class="flex-column o_stat_highlight"><t t-esc="state.stats.total_amount"/></span>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="d-flex">
                        <span class="flex-column me-3">Average amount of t-shirt by order this month</span>
                        <span class="flex-column o_stat_highlight"><t t-esc="state.stats.average_quantity"/></span>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="d-flex">
                        <span class="flex-column me-3">Number of cancelled orders this month</span>
                        <span class="flex-column o_stat_highlight"><t t-esc="state.stats.nb_cancelled_orders"/></span>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="d-flex">
                        <span class="flex-column me-3">Average time for an order to go from ‘new’ to ‘sent’ or ‘cancelled’</span>
                        <span class="flex-column o_stat_highlight"><t t-esc="state.stats.average_time"/></span>
                    </div>
                </DashboardItem>
                 <DashboardItem size="2">
                     <PieChart data="state.stats.orders_by_size" />
                 </DashboardItem>
            </div>
        </div>
    </t>

</templates>