<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <div class="o_dashboard h-100">
            <div class="o_control_panel d-flex align-items-center p-3 border-bottom">
                <button class="btn btn-primary me-2" t-on-click="openCustomers">
                    Customers
                </button>
                <button class="btn btn-primary me-2" t-on-click="openLeads">
                    Leads
                </button>
                <h2 class="mb-0">Dashboard</h2>
            </div>
            <div class="d-flex flex-wrap">
                <DashboardItem>
                    <div>Card with default size (1)</div>
                    <button class="btn btn-primary mt-2" t-on-click="openCustomers">
                        Customers
                    </button>
                </DashboardItem>

                <DashboardItem size="2">
                    <div>Card with size 2</div>
                    <button class="btn btn-primary mt-2" t-on-click="openLeads">
                        Leads
                    </button>
                </DashboardItem>
            </div>
        </div>
    </t>

</templates>