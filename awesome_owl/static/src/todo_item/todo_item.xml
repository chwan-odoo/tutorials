<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem">
        <div t-if="props.todo" class="p-3">
            <p t-att-class="{'text-muted': props.todo.isCompleted, 'text-decoration-line-through': props.todo.isCompleted}">
                <b><t t-esc="props.todo.id"/>. <t t-esc="props.todo.description"/></b>
            </p>
        </div>
        <div t-if="!props.todo" class="p-3">
            <h2>This is a placeholder for null props</h2>
        </div>
    </t>
</templates>
