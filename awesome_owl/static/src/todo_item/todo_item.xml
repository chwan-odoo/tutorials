<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem">
        <div class="container">
            <div class="row">
                <div class="col-6">
                    <div t-if="props.todo" class="row p-3">
                        <div class="col-auto pt-1">
                            <input type="checkbox" t-att-checked="props.todo.isCompleted" t-on-change="onToggle"/>
                        </div>
                        <div class="col pt">
                            <p t-att-class="{'text-muted': props.todo.isCompleted, 'text-decoration-line-through': props.todo.isCompleted}">
                                <b><t t-esc="props.todo.id"/>. <t t-esc="props.todo.description"/></b>
                            </p>
                        </div>
                        <div class="col-auto pt-1">
                            <span class="fa fa-remove" style="color:red; cursor:pointer;" t-on-click="() => props.removeTodo(props.todo.id)" />
                        </div>
                    </div>
                    <div t-if="!props.todo" class="p-3">
                        <h2>This is a placeholder for null props</h2>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>