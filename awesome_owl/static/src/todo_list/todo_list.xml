<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoList">
        <div class="p-3">
            <label for="new-todo"><b>Add a new todo: </b></label>
            <input t-ref="the_input_bar" t-on-keyup="addTodo"></input>
            <t t-foreach="todoList" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo" removeTodo="removeTodo"/>
            </t>
        </div>
    </t>

</templates>